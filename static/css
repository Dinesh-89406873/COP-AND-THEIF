*{box-sizing:border-box}html{min-height:100%;background:#080914}body{margin:0;min-height:100vh;font-family:Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 15% 5%,#2b1a56 0,transparent 30%),radial-gradient(circle at 90% 15%,#18375b 0,transparent 28%),linear-gradient(145deg,#070812,#11152c 55%,#090a13);color:#f8fafc}body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:32px 32px}.container{max-width:1100px;margin:auto;padding:24px}.card,.hero-card{background:linear-gradient(145deg,rgba(24,28,56,.94),rgba(11,14,31,.94));border:1px solid rgba(255,255,255,.12);border-radius:24px;padding:24px;margin:18px 0;box-shadow:0 20px 60px rgba(0,0,0,.22)}h1,h2,h3,p{margin-top:0}a{color:#ffdf7d}button,.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 19px;margin:8px 4px;border:1px solid transparent;border-radius:13px;background:linear-gradient(135deg,#ffdf7d,#f6c453);color:#17120a;font-weight:900;cursor:pointer;text-decoration:none}button:disabled{opacity:.45;cursor:not-allowed}input,select{width:100%;padding:14px 15px;margin:8px 0;border-radius:13px;border:1px solid rgba(255,255,255,.12);background:#fff;color:#111;font-size:15px}.auth{max-width:460px;margin:9vh auto;padding:34px}.auth h1{font-size:36px;letter-spacing:2px;color:#fff}.auth form{display:grid;gap:4px}.auth form button{width:100%;margin:8px 0}.error{padding:12px 14px;margin:12px 0;border-radius:12px;background:rgba(255,102,120,.12);border:1px solid #ff6678;color:#ffd4d9}.topbar{display:flex;align-items:center;justify-content:space-between;padding:4px 0 14px}.brand{display:flex;align-items:center;gap:12px}.brand-crown{font-size:38px}.brand h1{font-size:20px;letter-spacing:4px;margin:0}.exit-link{padding:9px 13px;border:1px solid rgba(255,255,255,.12);border-radius:12px;text-decoration:none;color:#fff}.muted{color:#a9b0c7}.hidden{display:none!important}.secondary{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.15);color:#fff}
/* Room UI */
.room-container{max-width:1080px}.room-topbar{display:flex;align-items:center;justify-content:space-between;padding:0 0 16px}.room-brand{display:flex;align-items:center;gap:14px}.room-brand span{font-size:34px}.room-brand h1{font-size:32px;margin:0;font-weight:900}.home-link{font-size:16px}.room-card{padding:28px 30px;border-radius:26px;background:linear-gradient(145deg,rgba(19,22,49,.95),rgba(8,11,28,.96));border:1px solid rgba(255,255,255,.16);box-shadow:0 24px 70px rgba(0,0,0,.26)}.room-heading-row{display:flex;justify-content:space-between;gap:24px;align-items:flex-start}.room-heading-row h2{font-size:26px;margin-bottom:16px}.room-heading-row h2 strong{color:#ffcf4a;font-size:34px;letter-spacing:1px}.room-heading-row p{color:#f2f4fa}.player-count{border:1px solid rgba(49,227,133,.5);background:rgba(11,88,56,.14);color:#43f08b;padding:12px 18px;border-radius:999px;font-weight:800;white-space:nowrap}.room-actions{display:flex;gap:10px;margin:10px 0 18px}.room-btn{min-width:200px;font-size:16px;padding:15px 22px}.room-btn.purple{background:linear-gradient(135deg,#a65cff,#6e31df);color:#fff;border-color:#c18cff}.room-btn.gold{background:linear-gradient(135deg,#ffe37e,#f6c453);color:#16120a}.room-notice{padding:12px 16px;border-radius:12px;margin:12px 0;background:rgba(70,125,255,.12);border:1px solid rgba(100,150,255,.4);color:#cfe1ff}.room-notice.error{background:rgba(255,82,110,.12);border-color:rgba(255,102,120,.7);color:#ffd7dc}.players-section{margin-top:24px}.section-title{display:flex;align-items:center;gap:12px;color:#ffd447}.section-title span{font-size:25px}.section-title h3{margin:0;font-size:22px}.title-line{height:1px;background:linear-gradient(90deg,#e6c74b 0,#423d64 25%,rgba(255,255,255,.1) 100%);margin:14px 0}.players-list{display:grid;gap:9px}.player-row{display:flex;align-items:center;gap:16px;padding:12px 16px;border-radius:13px;background:linear-gradient(90deg,rgba(30,32,75,.7),rgba(19,22,53,.75));border:1px solid rgba(90,90,180,.25);min-height:68px}.player-row.system-player{background:linear-gradient(90deg,rgba(43,23,76,.72),rgba(18,22,56,.75));border-color:rgba(163,93,255,.32)}.avatar{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#7a32dc,#4c1e9b);font-weight:900;font-size:20px;flex:0 0 46px}.bot-avatar{background:linear-gradient(135deg,#8c4cff,#48208e)}.player-main{flex:1;display:flex;flex-direction:column;gap:4px}.player-main b{font-size:18px}.player-main small{color:#9da5c3;font-size:11px;letter-spacing:.8px}.ready-pill{color:#3ef08a;font-size:16px;font-weight:700}.player-number{color:#b7b9d2;font-size:16px;width:20px;text-align:center}.friends-section{margin-top:24px}.friends-section h3{margin-bottom:8px}.friend-chip{background:rgba(118,55,218,.18);border:1px solid rgba(168,110,255,.35);color:#e7d8ff;padding:8px 13px;margin:3px}.room-footer{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-top:42px;padding:17px 20px;border:1px solid rgba(92,99,170,.28);border-radius:16px;background:rgba(10,13,34,.7);color:#cfd6ed}.room-footer span:nth-child(2){text-align:center}.room-footer span:nth-child(3){text-align:right}.error-page{text-align:center;max-width:720px;margin:10vh auto}.error-icon{font-size:58px;margin-bottom:8px}
@media(max-width:760px){.container{padding:14px}.card,.hero-card{border-radius:19px;padding:18px;margin:12px 0}.auth{margin:4vh 14px}.auth h1{font-size:30px}.room-card{padding:20px 16px}.room-heading-row{flex-direction:column}.room-heading-row h2 strong{font-size:28px}.player-count{align-self:flex-start}.room-actions{flex-direction:column}.room-btn{width:100%;margin:4px 0}.room-footer{grid-template-columns:1fr;text-align:left}.room-footer span:nth-child(2),.room-footer span:nth-child(3){text-align:left}.player-row{gap:10px}.ready-pill{font-size:13px}}

/* Royal scroll sheet fallback */

/* Royal parchment scroll sheet */
.scroll-overlay{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(4,6,18,.78);backdrop-filter:blur(7px);opacity:0;pointer-events:none;transition:opacity .22s ease}
.scroll-overlay.show{opacity:1;pointer-events:auto}
.scroll-stage{width:min(720px,94vw);max-height:88vh;position:relative;filter:drop-shadow(0 28px 55px rgba(0,0,0,.55));}
.scroll-rolled{width:100%;height:82px;position:relative;z-index:5;border-radius:42px;background:linear-gradient(180deg,#f8df9b,#c58a3b 48%,#8d5525);border:3px solid #6c3e1d;box-shadow:inset 0 8px 10px rgba(255,255,255,.35),inset 0 -10px 12px rgba(70,31,8,.4),0 10px 22px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;color:#4b2a13;font-weight:1000;letter-spacing:3px;text-transform:uppercase}
.scroll-rolled:before,.scroll-rolled:after{content:"";position:absolute;top:10px;bottom:10px;width:18px;border-radius:12px;background:linear-gradient(90deg,#6c3e1d,#f0c56b,#7d451e);box-shadow:0 2px 7px rgba(0,0,0,.35)}
.scroll-rolled:before{left:12px}.scroll-rolled:after{right:12px}
.scroll-top{position:relative;z-index:4;transform-origin:50% 100%;}
.scroll-top.closed{animation:scrollClosed .35s ease both}
.scroll-paper{position:relative;margin:-4px 28px 0;max-height:0;overflow:hidden;transform-origin:50% 0;background:linear-gradient(90deg,#d9a95e 0,#fff1bd 7%,#fff9df 50%,#f6d98f 93%,#c78b3c 100%);border-left:4px solid #875020;border-right:4px solid #875020;box-shadow:inset 0 0 34px rgba(116,67,18,.20);transition:max-height .75s cubic-bezier(.22,.8,.25,1),padding .75s ease}
.scroll-paper.open{max-height:62vh;padding:30px 34px 34px;overflow:auto;animation:paperUnroll .75s cubic-bezier(.22,.8,.25,1) both}
.scroll-paper.closing{max-height:0;padding-top:0;padding-bottom:0;animation:paperRoll .45s ease both}
.scroll-bottom{height:66px;margin:-3px 0 0;position:relative;z-index:4;border-radius:34px;background:linear-gradient(180deg,#8d5525,#c58a3b 50%,#f8df9b);border:3px solid #6c3e1d;box-shadow:inset 0 -8px 10px rgba(255,255,255,.25),inset 0 8px 12px rgba(70,31,8,.35);transform-origin:50% 0;opacity:0;transform:translateY(-12px) scaleY(.65)}
.scroll-paper.open + .scroll-bottom{animation:bottomDrop .65s .18s ease forwards}
.scroll-title{text-align:center;color:#6d3d18;font-size:13px;letter-spacing:3px;font-weight:1000;margin-bottom:14px}.scroll-role{text-align:center;color:#3e2513;font-size:38px;line-height:1.1;font-weight:1000;text-shadow:0 1px 0 #fff2bd;margin:8px 0 10px}.scroll-tamil{text-align:center;color:#6f431e;font-size:20px;font-weight:800;margin:0 0 22px}.scroll-points{max-width:520px;margin:auto;border:2px dashed rgba(111,67,30,.55);border-radius:16px;padding:16px;text-align:center;color:#5b3417;background:rgba(255,250,224,.58);font-weight:900}.scroll-points b{display:block;font-size:34px;margin:5px 0}.scroll-points span{display:block;font-size:11px;letter-spacing:.8px;font-weight:800}.scroll-close{position:absolute;right:8px;top:-12px;z-index:8;width:42px;height:42px;padding:0;border-radius:50%;background:#1b1730;color:#fff;border:2px solid #ffdf7d;box-shadow:0 6px 18px rgba(0,0,0,.35);font-size:18px;margin:0}
@keyframes paperUnroll{0%{transform:scaleY(.03);opacity:.15}55%{transform:scaleY(1.03);opacity:1}100%{transform:scaleY(1);opacity:1}}
@keyframes paperRoll{0%{transform:scaleY(1);opacity:1}100%{transform:scaleY(.03);opacity:0}}
@keyframes bottomDrop{0%{opacity:0;transform:translateY(-12px) scaleY(.65)}100%{opacity:1;transform:translateY(0) scaleY(1)}}
@keyframes scrollClosed{0%{transform:scaleY(.92)}100%{transform:scaleY(1)}}
@media(max-width:600px){.scroll-overlay{padding:12px}.scroll-stage{width:96vw}.scroll-rolled{height:68px;font-size:11px}.scroll-paper.open{padding:22px 18px 24px;max-height:67vh}.scroll-role{font-size:30px}.scroll-tamil{font-size:17px}.scroll-bottom{height:54px}.scroll-close{right:2px;top:-8px}}
