*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(135deg,#1b103d,#341d62,#0f172a);color:#fff;min-height:100vh}.container{max-width:900px;margin:auto;padding:30px}.card,.hero{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);border-radius:18px;padding:24px;margin:18px 0;backdrop-filter:blur(8px)}.auth{width:420px;max-width:92%;margin:8vh auto;text-align:center}h1{font-size:34px}input{width:100%;padding:13px;margin:8px 0;border-radius:10px;border:0}button,.btn{display:inline-block;padding:12px 18px;margin:8px 4px;border:0;border-radius:10px;background:#f4c542;color:#17120a;font-weight:bold;cursor:pointer;text-decoration:none}.secondary{background:#fff}.error{background:#7f1d1d;padding:10px;border-radius:8px;margin:10px 0}.code{letter-spacing:5px;color:#ffd54a}.player{padding:12px;background:rgba(255,255,255,.08);border-radius:10px;margin:6px 0}.secret{margin:18px 0;padding:25px;border:2px dashed #f4c542;border-radius:15px;text-align:center}.hidden{display:none}label{display:block;padding:10px;font-size:17px}label input{width:auto}table{width:100%;border-collapse:collapse;margin-top:15px}th,td{padding:12px;border-bottom:1px solid #ffffff33;text-align:left}a{color:#ffd54a}

select{width:100%;padding:13px;margin:8px 0;border-radius:10px;border:0;background:#fff;color:#111}
button:disabled{opacity:.5;cursor:not-allowed}
.result-box{padding:14px;border-radius:10px;margin-top:12px;min-height:10px}
.result-box.right{background:#166534;border:1px solid #4ade80}
.result-box.wrong{background:#7f1d1d;border:1px solid #f87171}

.round-row{padding:12px;margin:7px 0;border-radius:10px;background:rgba(255,255,255,.08);border-left:4px solid #f4c542}.round-right{border-left-color:#4ade80}.round-wrong{border-left-color:#f87171}
.profile-editor{padding:14px;border-radius:14px;background:rgba(255,255,255,.06);margin-bottom:18px}.profile-editor input{margin:10px 0 4px}.profile-editor small{display:block;opacity:.75}.profile-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.profile-card{display:flex;align-items:center;gap:12px;padding:14px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12)}.profile-info h3{margin:0 0 5px}.profile-info span{font-size:12px;opacity:.75}.avatar{width:58px;height:58px;border-radius:50%;object-fit:cover;border:2px solid #f4c542;display:inline-flex;align-items:center;justify-content:center;flex:none}.avatar-placeholder{background:#2b2050;font-size:22px;font-weight:bold}.readonly-note{font-size:14px;opacity:.8}.table-wrap{overflow-x:auto}.points-table td:nth-child(2){display:flex;align-items:center;gap:10px}.points-table .avatar{width:36px;height:36px;font-size:14px}.points-table td,.points-table th{vertical-align:middle}

.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.home-hero{display:flex;justify-content:space-between;align-items:center;gap:24px}.home-profile{width:180px;text-align:center}.home-avatar{width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #f4c542;display:block;margin:0 auto 10px}.home-profile input{font-size:12px}.friend-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px;margin:7px 0;border-radius:10px;background:rgba(255,255,255,.07)}.friend-row button{padding:7px 10px;font-size:12px}.friend-chip{padding:9px 12px}.eyebrow{font-size:11px;letter-spacing:2px;opacity:.7}.round-banner{display:flex;align-items:center;justify-content:space-between}.round-banner h2{margin:4px 0}.sheet-role{font-size:32px;font-weight:800;color:#ffd54a}.locked-points{padding:28px;text-align:center;border:1px dashed #ffffff55;border-radius:14px;background:rgba(255,255,255,.04)}.reveal-card{border:1px solid #f4c542aa;box-shadow:0 0 30px rgba(244,197,66,.12);animation:revealIn .45s ease}.reveal-title{display:flex;gap:14px;align-items:center}.reveal-title>span{font-size:38px}.reveal-title h2{margin:3px 0}.who-thief{font-size:30px;font-weight:900;text-align:center;padding:20px;border-radius:16px;margin:15px 0;animation:pulseReveal .9s ease}.who-thief.correct{background:#14532d;border:2px solid #4ade80}.who-thief.wrong{background:#7f1d1d;border:2px solid #f87171}.lock-message{padding:12px;border-radius:10px;background:rgba(255,255,255,.07)}.sheet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}.revealed-sheet{padding:15px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);display:flex;flex-direction:column;gap:6px}.revealed-sheet span{font-size:19px;color:#ffd54a;font-weight:700}.revealed-sheet small{opacity:.75}.history-card{padding:15px;margin:10px 0;border-radius:14px;background:rgba(255,255,255,.06);border-left:4px solid #f4c542}.history-right{border-left-color:#4ade80}.history-wrong{border-left-color:#f87171}.history-head{display:flex;justify-content:space-between}.bonus{font-weight:800;color:#ffd54a}.back-home-wrap{text-align:center;margin:28px 0}.back-home{font-size:17px;padding:14px 28px}@keyframes revealIn{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}@keyframes pulseReveal{0%{transform:scale(.94);opacity:.2}60%{transform:scale(1.03);opacity:1}100%{transform:scale(1)}}@media(max-width:700px){.grid-2{grid-template-columns:1fr}.home-hero,.round-banner{flex-direction:column;align-items:flex-start}.home-profile{align-self:center}.sheet-grid{grid-template-columns:1fr}.who-thief{font-size:22px}}
.history-sheets{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:7px;margin-top:10px}.history-sheets span{padding:8px;border-radius:8px;background:rgba(255,255,255,.06);font-size:12px}details summary{cursor:pointer;color:#ffd54a;font-weight:bold;margin-top:8px}
