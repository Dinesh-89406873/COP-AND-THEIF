*{box-sizing:border-box}
:root{--bg:#080914;--panel:rgba(17,20,42,.82);--line:rgba(255,255,255,.12);--gold:#f6c453;--gold2:#ffdf7d;--text:#f8fafc;--muted:#a9b0c7;--green:#50e3a4;--red:#ff6678;--blue:#77a7ff}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 15% 5%,#2b1a56 0,transparent 30%),radial-gradient(circle at 90% 15%,#18375b 0,transparent 28%),linear-gradient(145deg,#070812,#11152c 55%,#090a13);color:var(--text);min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,#000,transparent 85%)}
.container{max-width:1100px;margin:auto;padding:24px}
.card,.hero-card{background:linear-gradient(145deg,rgba(24,28,56,.88),rgba(11,14,31,.88));border:1px solid var(--line);border-radius:24px;padding:24px;margin:18px 0;box-shadow:0 20px 60px rgba(0,0,0,.22);backdrop-filter:blur(14px)}
h1,h2,h3,p{margin-top:0}.muted{color:var(--muted);line-height:1.55}.eyebrow{font-size:10px;letter-spacing:2.5px;color:#8e98b8;font-weight:800}.hidden{display:none!important}
button,.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 19px;margin:8px 4px;border:1px solid transparent;border-radius:13px;background:linear-gradient(135deg,var(--gold2),var(--gold));color:#17120a;font-weight:900;cursor:pointer;text-decoration:none;transition:.18s transform,.18s box-shadow,.18s opacity}
button:hover,.btn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(246,196,83,.18)}button:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}
input,select{width:100%;padding:14px 15px;margin:8px 0;border-radius:13px;border:1px solid var(--line);background:#fff;color:#111;font-size:15px}
a{color:var(--gold2)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:4px 0 14px}.brand{display:flex;align-items:center;gap:12px}.brand-crown{font-size:38px;color:var(--gold)}.brand h1{font-size:20px;letter-spacing:4px;margin:0}.brand small{font-size:9px;letter-spacing:3px;color:var(--muted)}.exit-link{padding:9px 13px;border:1px solid var(--line);border-radius:12px;text-decoration:none;color:#fff}
.hero-card{display:flex;align-items:center;justify-content:space-between;gap:22px;padding:20px}.hero-main{display:flex;align-items:center;gap:18px}.round-orb{width:82px;height:82px;flex:none;border-radius:25px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,#f8d878,#9d6b14);color:#15100a;box-shadow:0 0 40px rgba(246,196,83,.18)}.round-orb span{font-size:9px;font-weight:900;letter-spacing:2px}.round-orb b{font-size:30px}.hero-card h2{margin:4px 0 6px}.timer-panel{min-width:180px;text-align:center;padding:14px 18px;border-radius:18px;border:1px solid rgba(246,196,83,.3);background:rgba(246,196,83,.07)}.timer-panel span{display:block;font-size:9px;letter-spacing:2px;color:var(--gold2);font-weight:900}.timer-panel strong{display:block;font-variant-numeric:tabular-nums;font-size:34px;letter-spacing:2px;color:var(--gold2)}.timer-panel small{color:var(--muted)}.timer-panel.urgent{border-color:rgba(255,102,120,.65);background:rgba(255,50,80,.10);animation:urgent .8s infinite alternate}.timer-panel.urgent strong{color:#ff8290}
.police-banner{display:flex;align-items:center;gap:16px;padding:18px 20px}.police-icon{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:rgba(119,167,255,.12);font-size:27px;border:1px solid rgba(119,167,255,.22)}.police-banner h2{margin:3px 0}.live-dot{margin-left:auto;display:flex;gap:7px;align-items:center;font-size:10px;font-weight:900;letter-spacing:1.5px;color:var(--green)}.live-dot i{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green);animation:blink 1s infinite}
.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px}.privacy-pill,.danger-pill,.reveal-pill{font-size:9px;font-weight:900;letter-spacing:1.5px;padding:7px 10px;border-radius:999px}.privacy-pill{background:rgba(119,167,255,.12);color:#a8c4ff}.danger-pill{background:rgba(255,102,120,.11);color:#ff9daa}.reveal-pill{background:rgba(80,227,164,.11);color:var(--green)}
.secret-card{border-color:rgba(246,196,83,.2)}.secret{margin:18px 0;padding:28px;border:1px dashed rgba(246,196,83,.6);border-radius:18px;text-align:center;background:radial-gradient(circle at 50% 0,rgba(246,196,83,.12),transparent 65%);animation:rise .35s ease}.sheet-role{font-size:34px;font-weight:950;color:var(--gold2);text-shadow:0 0 24px rgba(246,196,83,.18)}.ghost-btn{background:transparent;color:#fff;border-color:var(--line);box-shadow:none}
.police-action{border-color:rgba(119,167,255,.32);background:linear-gradient(145deg,rgba(24,37,70,.88),rgba(11,14,31,.9))}.lock-btn{width:100%;background:linear-gradient(135deg,#88b2ff,#4778d9);color:#fff}.result-box{padding:14px;border-radius:14px;margin-top:12px;min-height:8px}.result-box.right{background:rgba(22,101,52,.5);border:1px solid #4ade80}.result-box.wrong{background:rgba(127,29,29,.5);border:1px solid #f87171}
.locked-points{padding:30px;text-align:center;border:1px dashed var(--line);border-radius:18px;background:rgba(255,255,255,.025);color:var(--muted)}.locked-points span{display:block;font-size:34px;margin-bottom:8px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:separate;border-spacing:0 7px;margin-top:12px}th{color:#8992ad;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;text-align:left;padding:10px 12px}td{padding:14px 12px;background:rgba(255,255,255,.045);border-top:1px solid rgba(255,255,255,.05);border-bottom:1px solid rgba(255,255,255,.05)}td:first-child{border-radius:12px 0 0 12px}td:last-child{border-radius:0 12px 12px 0}.points-table td:nth-child(4){font-size:18px;color:var(--gold2)}.system-tag{font-size:8px;color:#9fb9ff;border:1px solid #4b659c;padding:3px 5px;border-radius:5px}
.reveal-card{border-color:rgba(246,196,83,.35);box-shadow:0 0 50px rgba(246,196,83,.08);animation:rise .45s ease}.who-thief{font-size:clamp(22px,4vw,38px);font-weight:950;text-align:center;padding:22px;border-radius:18px;margin:16px 0;letter-spacing:.5px}.who-thief.correct{background:rgba(20,83,45,.5);border:1px solid #4ade80}.who-thief.wrong{background:rgba(127,29,29,.5);border:1px solid #f87171}.who-thief.timeout{background:rgba(125,78,15,.35);border:1px solid var(--gold)}.lock-message{padding:13px 15px;border-radius:13px;background:rgba(255,255,255,.045);color:#d9deec}.sheet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.revealed-sheet{padding:16px;border-radius:16px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:6px}.revealed-sheet span{font-size:18px;color:var(--gold2);font-weight:800}.revealed-sheet small{color:var(--muted)}
.history-card{padding:16px;margin:10px 0;border-radius:16px;background:rgba(255,255,255,.035);border-left:4px solid var(--gold)}.history-right{border-left-color:var(--green)}.history-wrong{border-left-color:var(--red)}.history-timeout{border-left-color:var(--gold)}.history-head{display:flex;justify-content:space-between;gap:10px}.history-sheets{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:7px;margin-top:10px}.history-sheets span{padding:9px;border-radius:9px;background:rgba(255,255,255,.05);font-size:12px}details summary{cursor:pointer;color:var(--gold2);font-weight:800;margin-top:9px}.bonus{font-weight:900;color:var(--gold2)}
.king-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;border-color:rgba(246,196,83,.3)}.king-emblem{width:56px;height:56px;display:grid;place-items:center;border-radius:17px;background:rgba(246,196,83,.10);font-size:27px;color:var(--gold)}.close-btn{background:linear-gradient(135deg,#ff7d8d,#d23f55);color:#fff}.final-winner{margin-top:14px;padding:18px;border-radius:16px;background:rgba(246,196,83,.08);border:1px solid rgba(246,196,83,.25)}
.back-home-wrap{text-align:center;margin:28px 0}.back-home{font-size:16px}
@keyframes blink{50%{opacity:.35}}@keyframes urgent{from{transform:scale(1)}to{transform:scale(1.035)}}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@media(max-width:760px){.container{padding:14px}.card,.hero-card{border-radius:19px;padding:18px;margin:12px 0}.hero-card{align-items:stretch;flex-direction:column}.hero-main{align-items:flex-start}.round-orb{width:64px;height:64px;border-radius:18px}.round-orb b{font-size:24px}.timer-panel{min-width:0}.police-banner{align-items:flex-start}.live-dot{margin-left:auto}.king-card{grid-template-columns:auto 1fr}.king-card button{grid-column:1/-1;width:100%;margin:0}.brand h1{font-size:17px}.brand-crown{font-size:31px}.sheet-grid{grid-template-columns:1fr}.who-thief{font-size:24px}}
@media(max-width:430px){.police-banner{flex-wrap:wrap}.live-dot{width:100%;margin-left:70px}.section-head{gap:8px}.section-head h2{font-size:20px}.timer-panel strong{font-size:30px}th,td{padding:11px 8px;font-size:12px}}


/* ARASAN royal game controls */
.game-btn{position:relative;overflow:hidden;min-height:48px;border-radius:14px;border:2px solid rgba(255,224,126,.55);box-shadow:inset 0 2px 0 rgba(255,255,255,.38),inset 0 -5px 0 rgba(90,50,0,.16),0 7px 0 rgba(58,35,5,.28),0 12px 26px rgba(0,0,0,.22);letter-spacing:.7px;text-transform:uppercase;font-weight:950}.game-btn:before{content:"";position:absolute;left:10%;right:10%;top:5px;height:2px;background:rgba(255,255,255,.45);border-radius:50%;pointer-events:none}.game-btn:active{transform:translateY(4px);box-shadow:inset 0 2px 0 rgba(255,255,255,.25),inset 0 -2px 0 rgba(0,0,0,.15),0 3px 0 rgba(58,35,5,.28)}
.lock-btn{border-color:rgba(179,208,255,.75);box-shadow:inset 0 2px 0 rgba(255,255,255,.4),inset 0 -5px 0 rgba(20,49,110,.25),0 7px 0 rgba(20,49,110,.35),0 12px 26px rgba(20,49,110,.25)}
.close-btn{border-color:rgba(255,170,180,.75);box-shadow:inset 0 2px 0 rgba(255,255,255,.35),inset 0 -5px 0 rgba(110,15,30,.25),0 7px 0 rgba(110,15,30,.35),0 12px 26px rgba(110,15,30,.22)}
.card h2,.hero-card h2{font-weight:950;letter-spacing:.2px}.eyebrow,.privacy-pill,.danger-pill,.reveal-pill{font-weight:950}.points-table th,.points-table td strong,.bonus,.who-thief,.sheet-role{font-weight:950}.points-table td:nth-child(2) b{font-weight:950}.police-banner h2{font-weight:950}.police-banner #policeName{color:var(--gold2);font-weight:950}.timer-panel strong{font-weight:950}

/* Closed scroll -> opening scroll animation for the private role sheet */
.secret-sheet{position:relative;margin:22px auto 18px;max-width:680px;min-height:250px;padding:54px 34px 34px;border:3px solid #b9852f;border-radius:18px;background:linear-gradient(180deg,#f7e3ad 0%,#e8c879 46%,#c79a4c 100%);color:#39270d;box-shadow:0 16px 34px rgba(0,0,0,.38),inset 0 0 0 6px rgba(255,246,200,.28);transform-origin:top center}.secret-sheet:before,.secret-sheet:after{content:"";position:absolute;left:7%;right:7%;height:22px;border-radius:50%;background:linear-gradient(180deg,#d3a252,#8d5b1b);border:2px solid #7d5015;box-shadow:0 5px 9px rgba(0,0,0,.28);z-index:2}.secret-sheet:before{top:-13px}.secret-sheet:after{bottom:-13px}.secret-sheet.opening{animation:scrollOpen .72s cubic-bezier(.22,.75,.25,1) both}.secret-sheet.closing{animation:scrollClose .25s ease-in both}.scroll-ribbon{font-size:10px;letter-spacing:2px;font-weight:950;color:#6d4310;margin-bottom:22px}.secret-sheet .sheet-role{font-size:clamp(32px,6vw,54px);color:#5b3510;text-shadow:0 2px 0 rgba(255,255,255,.4)}.secret-sheet .sheet-tamil{font-weight:800;color:#684a21}.sheet-points{display:inline-flex;align-items:baseline;gap:8px;margin-top:12px;padding:10px 16px;border-radius:999px;background:rgba(94,55,10,.12);border:1px solid rgba(94,55,10,.22);font-size:24px;font-weight:950}.sheet-points span{font-size:10px;letter-spacing:1.4px}.secret-sheet + .ghost-btn{color:#fff}
@keyframes scrollOpen{0%{opacity:0;transform:perspective(800px) rotateX(-78deg) scaleY(.15);filter:brightness(.72);max-height:55px}55%{opacity:1;transform:perspective(800px) rotateX(16deg) scaleY(.92);max-height:420px}100%{transform:perspective(800px) rotateX(0) scaleY(1);max-height:600px}}@keyframes scrollClose{from{opacity:1;transform:perspective(800px) rotateX(0) scaleY(1);max-height:600px}to{opacity:0;transform:perspective(800px) rotateX(-72deg) scaleY(.15);max-height:55px}}
@media(max-width:760px){.secret-sheet{padding:48px 20px 30px;min-height:220px}.game-btn{width:100%;margin:8px 0}.section-head{align-items:center}.points-table th{font-size:9px}}

/* ARASAN v7 setup + stronger hierarchy */
.create-page .create-hero{margin-top:8px}.create-hero h1{margin:5px 0;font-size:clamp(28px,5vw,44px)}
.create-form{padding:24px}.character-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0 24px}.role-choice{display:flex;align-items:center;gap:11px;padding:13px 14px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.035);cursor:pointer}.role-choice:hover{border-color:var(--gold)}.role-choice input{accent-color:var(--gold);width:18px;height:18px}.role-choice span{display:flex;flex-direction:column;gap:3px}.role-choice b{font-weight:900;letter-spacing:.3px}.role-choice small{color:var(--muted)}.role-points{margin-left:auto;flex:0 0 auto;padding:7px 10px;border:1px solid rgba(255,224,126,.38);border-radius:999px;background:rgba(255,196,67,.09);color:#ffe28b;font-size:12px;font-weight:950;letter-spacing:.7px;white-space:nowrap}.sheet-points b{font-size:28px;color:#5b3510}.sheet-points{flex-wrap:wrap}
.timer-setup{display:grid;grid-template-columns:1fr auto;align-items:center;gap:20px;padding:18px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(135deg,rgba(212,175,55,.10),rgba(255,255,255,.025));margin-bottom:20px}.timer-input-wrap{display:grid;grid-template-columns:auto 110px;gap:7px;align-items:center}.timer-input-wrap>span{font-size:24px}.timer-input-wrap input{font-size:25px;font-weight:900;text-align:center;padding:12px;border-radius:13px;border:1px solid var(--gold);background:#0b0b0d;color:#fff}.timer-input-wrap small{grid-column:2;text-align:center;color:var(--muted)}.create-btn{width:100%;font-weight:900;letter-spacing:.5px}
@media(max-width:650px){.character-grid{grid-template-columns:1fr}.timer-setup{grid-template-columns:1fr}.timer-input-wrap{justify-self:start}.create-form{padding:18px}}
